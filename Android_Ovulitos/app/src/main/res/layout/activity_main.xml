<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="59dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/rosa_oscuro"
            app:cardCornerRadius="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="34dp"
                    android:layout_height="31dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/boton_menu_izquierdo" />
                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="38dp"
                    android:layout_height="37dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/imagen_usuario" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/main_fragment_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="100dp"  app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topBar" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="32dp"
        app:behavior_hideable="false"
        app:behavior_peekHeight="90dp"
        app:cardBackgroundColor="#F8D7DA"
        app:cardCornerRadius="30dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:layout_marginBottom="0dp"
                android:background="#A1887F" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="4"
                android:useDefaultMargins="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_1"
                    style="@style/MenuButtonStyle"
                    app:srcCompat="@drawable/ciclo" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_2"
                    style="@style/MenuButtonStyle"
                    app:srcCompat="@drawable/calendario" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_3"
                    style="@style/MenuButtonStyle"
                    app:srcCompat="@drawable/relajacion" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_4"
                    style="@style/MenuButtonStyle"
                    app:srcCompat="@drawable/fertilidad" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_5"
                    style="@style/MenuButtonStyle"
                    app:srcCompat="@drawable/emociones" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_6"
                    style="@style/MenuButtonStyle"
                    app:srcCompat="@drawable/noticias" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_7"
                    style="@style/MenuButtonStyle"
                    app:srcCompat="@drawable/noticias" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_8"
                    style="@style/MenuButtonStyle"
                    app:srcCompat="@drawable/noticias" />

            </GridLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>