<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visibilidad en el Chat"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque"
            android:textSize="16sp"
            android:textColor="@color/black"/>
        <Switch
            android:id="@+id/switchVisibilidadChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mostrar mi perfil en el chat social"
            android:fontFamily="@font/bricolage_grotesque"
            android:textColor="#6D4C41"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compartir mis datos"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque"
            android:textSize="16sp"
            android:textColor="@color/black"/>
        <Switch
            android:id="@+id/switchCompartirDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ayudar a mejorar la app de forma anónima"
            android:fontFamily="@font/bricolage_grotesque"
            android:textColor="#6D4C41"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Términos y Políticas"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque"
            android:textSize="16sp"
            android:textColor="@color/black"/>
        <TextView
            android:id="@+id/btnTerminosPrivacidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leer términos de privacidad"
            android:fontFamily="@font/bricolage_grotesque"
            android:textColor="#6D4C41"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exportar mis datos"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque"
            android:textSize="16sp"
            android:textColor="@color/black"/>
        <TextView
            android:id="@+id/btnExportarDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descargar una copia de mis datos"
            android:fontFamily="@font/bricolage_grotesque"
            android:textColor="#6D4C41"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuarios Bloqueados"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque"
            android:textSize="16sp"
            android:textColor="@color/black"/>

    </LinearLayout>
</ScrollView>