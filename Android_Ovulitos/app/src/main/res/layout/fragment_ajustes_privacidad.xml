        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Todos/Nadie"
            android:fontFamily="@font/bricolage_grotesque"
            android:textColor="#6D4C41"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
