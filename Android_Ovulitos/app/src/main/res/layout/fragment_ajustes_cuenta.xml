<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Información de la cuenta"
            android:fontFamily="@font/bricolage_grotesque"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginBottom="20dp"/>

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/imgFotoPerfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_placeholder"
                android:background="@drawable/circle_background"
                android:clipToOutline="true"/>

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/circle_background"
                android:src="@android:drawable/ic_menu_edit"
                android:padding="6dp"
                android:tint="#FFF"
                android:backgroundTint="#FF4081"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre de usuario"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/txtNombreUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando..."
            android:fontFamily="@font/bricolage_grotesque"
            android:textColor="#6D4C41"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/txtEmailUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando..."
            android:fontFamily="@font/bricolage_grotesque"
            android:textColor="#6D4C41"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado Social"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque"
            android:textColor="@color/black"/>
        <TextView
            android:id="@+id/txtEstadoSocial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Casada/Soltera"
            android:fontFamily="@font/bricolage_grotesque"
            android:textColor="#6D4C41"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/btnEliminarCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eliminar cuenta permanentemente"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque"
            android:textColor="#D32F2F"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>