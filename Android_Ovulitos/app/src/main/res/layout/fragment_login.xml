<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="40dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/logo_ovulitos"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ovulitos"
                android:fontFamily="@font/titan_one"
                android:textColor="@color/texto_marron"
                android:textSize="24sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicio de sesión"
            android:fontFamily="@font/titan_one"
            android:textColor="@color/texto_marron"
            android:textSize="22sp"
            android:layout_marginBottom="30dp"/>

        <EditText
            android:id="@+id/etUsuario"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/fondo_input_login"
            android:hint="Nombre de usuario"
            android:textColorHint="#4E342E"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/fondo_input_login"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:textColorHint="#4E342E"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Olvidaste tu contraseña? Haz click aquí"
            android:textSize="12sp"
            android:layout_gravity="end"
            android:layout_marginBottom="32dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="200dp"
            android:layout_height="55dp"
            android:background="@drawable/boton_redondeado_rosa"
            android:text="Siguiente"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿No tienes cuenta?"
            android:layout_marginTop="16dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnIrARegistro"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:background="@drawable/boton_redondeado_rosa"
            android:text="Regístrate"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>