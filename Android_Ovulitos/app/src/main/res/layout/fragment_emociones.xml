<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <TextView
        android:id="@+id/tvPregunta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/dia_ciclo"
        android:fontFamily="@font/bricolage_grotesque_bold"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:text="@string/pregunta_emociones"
        android:textColor="@color/textos"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivTarro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/tarro_emociones"
            app:layout_constraintBottom_toTopOf="@id/containerEmociones"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPregunta" />

        <FrameLayout
            android:id="@+id/flTarroContenido"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="80dp" 
            android:layout_marginBottom="25dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            app:layout_constraintBottom_toBottomOf="@id/ivTarro"
            app:layout_constraintEnd_toEndOf="@id/ivTarro"
            app:layout_constraintStart_toStartOf="@id/ivTarro"
            app:layout_constraintTop_toTopOf="@id/ivTarro" />

        <LinearLayout
            android:id="@+id/containerEmociones"
            android:layout_width="wrap_content"
            android:layout_height="88dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/dia_ciclo"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageButton
                android:id="@+id/btnEmojiFeliz"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/alegria" />

            <ImageButton
                android:id="@+id/btnEmojiTriste"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/tristeza" />

            <ImageButton
                android:id="@+id/btnEmojiEnojo"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/ira" />

            <ImageButton
                android:id="@+id/btnEmojiSorpresa"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/miedo" />

            <ImageButton
                android:id="@+id/btnEmojiCalma"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/serenidad" />
        </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>